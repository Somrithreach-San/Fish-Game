# Auto detect text files and perform LF normalization
* text=auto
*.mp4 filter=lfs diff=lfs merge=lfs -text
Assets/Graphics/Backgrounds/*.png filter=lfs diff=lfs merge=lfs -text
Assets/Graphics/GUI[[:space:]]Components/*.png filter=lfs diff=lfs merge=lfs -text
*.unityweb -text
*.wasm -text
*.data -text
